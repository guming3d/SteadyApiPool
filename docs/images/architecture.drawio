<mxfile host="drawio" version="26.0.0"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;SteadyApiPool&lt;/b&gt;: one endpoint for clients, a pool of Foundry deployments behind it" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1000" height="34" as="geometry"/></mxCell><mxCell id="manager" value='&lt;b&gt;SteadyApiPool manager&lt;/b&gt; (web app, runs locally or on App Service)&lt;br&gt;&lt;span style="font-size:11px"&gt;finds the Foundry deployments, creates and publishes pools, deploys or connects the gateway, monitors it&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=74;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1460" height="70" as="geometry"/></mxCell><mxCell id="manager-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="manager"><mxGeometry x="14" y="11" width="48" height="48" as="geometry"/></mxCell><mxCell id="apim" value="Azure API Management" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="460" height="400" as="geometry"/></mxCell><mxCell id="apim-clients" value='&lt;b&gt;Client apps&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;OpenAI SDK, curl, …&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=54;container=1;p