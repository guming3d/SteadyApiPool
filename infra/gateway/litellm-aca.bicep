// A LiteLLM AI gateway on Azure Container Apps, deployed by the app's setup wizard with the
// signed-in user's own rights (and usable on its own with `az deployment group create`).
//
//   Container App: LiteLLM (port 4000, external HTTPS ingress) + an OpenTelemetry Collector
//                  sidecar that sends LiteLLM's spans to Application Insights
//   User-assigned identity: what LiteLLM calls Foundry deployments as (AZURE_CLIENT_ID);
//                  the setup wizard grants it Cognitive Services OpenAI User on member accounts
//   Postgres Flexible Server: LiteLLM's model table, virtual keys and spend
//   Azure Managed Redis (production profile, more than one replica): shared cooldown state
//   Log Analytics + Application Insights
//
// The app compiles this file to backend/pool_manager/templates/litellm-aca.json
// (az bicep build --file infra/gateway/litellm-aca.bicep --outfile backend/pool_manager/templates/litellm-aca.json).
// Secrets are parameters, generated by the app once and kept as Container App secrets: the salt
// key encrypts the member keys LiteLLM stores, so it must never change for a gateway.
targetScope = 'resourceGroup'

@minLength(2)
@maxLength(32)
@description('Name of the gateway; the Container App gets this name.')
param name string

param location string = resourceGroup().location

@allowed([ 'dev', 'production' ])
@description('dev: one replica, no Redis. production: 2-5 replicas sharing cooldowns through Redis.')
param profile string = 'dev'

@description('LiteLLM image, pinned so a redeploy never changes the version by itself.')
param image string = 'ghcr.io/berriai/litellm:v1.106.4'

param collectorImage string = 'otel/opentelemetry-collector-contrib:0.120.0'

@secure()
@description('LiteLLM master key (sk-...).')
param masterKey string

@secure()
@description('LiteLLM salt key, which encrypts stored credentials. Never change it.')
param saltKey string

@secure()
@description('Password of the Postgres administrator (letters and digits).')
param postgresPassword string

@secure()
@description('LiteLLM config.yaml, generated by the app.')
param litellmConfig string

@secure()
@description('OpenTelemetry Collector config, generated by the app.')
param collectorConfig string

param tags object = {}

var production = profile == 'production'
var suffix = uniqueString(resourceGroup().id, name)
var gatewayTags = union(tags, { 'managed-by': 'ai-gateway-pool', 'ai-gateway': name })
var postgresName = take('psql-${name}-${suffix}', 63)
var redisName = take('redis-${name}-${suffix}', 60)

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: 'log-${name}'
  location: location
  tags: gatewayTags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource insights 'Microsoft.Insights/components@2020-02-02' = {
  name: 'appi-${name}'
  location: location
  tags: gatewayTags
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: logs.id
  }
}

resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-${name}'
  location: location
  tags: gatewayTags
}

resource postgres 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: postgresName
  location: location
  tags: gatewayTags
  sku: {
    name: production ? 'Standard_B2s' : 'Standard_B1ms'
    tier: 'Burstable'
  }
  properties: {
    version: '16'
    administratorLogin: 'litellm'
    administratorLoginPassword: postgresPassword
    storage: { storageSizeGB: 32 }
    backup: { backupRetentionDays: 7, geoRedundantBackup: 'Disabled' }
    highAvailability: { mode: 'Disabled' }
    network: { publicNetworkAccess: 'Enabled' }
    authConfig: { activeDirectoryAuth: 'Disabled', passwordAuth: 'Enabled' }
  }

  resource database 'databases' = {
    name: 'litellm'
    properties: { charset: 'UTF8', collation: 'en_US.utf8' }
  }

  // Container Apps on the consumption plan have no fixed outbound address.
  resource azureServices 'firewallRules' = {
    name: 'AllowAllAzureServicesAndResourcesWithinAzureIps'
    properties: { startIpAddress: '0.0.0.0', endIpAddress: '0.0.0.0' }
  }
}

resource redis 'Microsoft.Cache/redisEnterprise@2025-04-01' = if (production) {
  name: redisName
  location: location
  tags: gatewayTags
  sku: { name: 'Balanced_B0' }
  properties: { minimumTlsVersion: '1.2' }
}

resource redisDatabase 'Microsoft.Cache/redisEnterprise/databases@2025-04-01' = if (production) {
  parent: redis
  name: 'default'
  properties: {
    clientProtocol: 'Encrypted'
    port: 10000
    clusteringPolicy: 'EnterpriseCluster'
    evictionPolicy: 'NoEviction'
    accessKeysAuthentication: 'Enabled'
  }
}

resource environment 'Microsoft.App/managedEnvironments@2025-01-01' = {
  name: 'cae-${name}'
  location: location
  tags: gatewayTags
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logs.properties.customerId
        sharedKey: logs.listKeys().primarySharedKey
      }
    }
  }
}

var databaseUrl = 'postgresql://litellm:${postgresPassword}@${postgres.properties.fullyQualifiedDomainName}:5432/litellm?sslmode=require'
var baseSecrets = [
  { name: 'litellm-master-key', value: masterKey }
  { name: 'litellm-salt-key', value: saltKey }
  { name: 'database-url', value: databaseUrl }
  { name: 'litellm-config', value: litellmConfig }
  { name: 'otel-config', value: collectorConfig }
  { name: 'appinsights-connection-string', value: insights.properties.ConnectionString }
]
var redisSecrets = production ? [ { name: 'redis-password', value: redisDatabase!.listKeys().primaryKey } ] : []
var baseEnv = [
  { name: 'LITELLM_MASTER_KEY', secretRef: 'litellm-master-key' }
  { name: 'LITELLM_SALT_KEY', secretRef: 'litellm-salt-key' }
  { name: 'DATABASE_URL', secretRef: 'database-url' }
  { name: 'STORE_MODEL_IN_DB', value: 'True' }
  // Foundry members are called as this identity (enable_azure_ad_token_refresh).
  { name: 'AZURE_CLIENT_ID', value: identity.properties.clientId }
  // LiteLLM's OpenTelemetry v2 instrumentation: a span per model call, which the app's
  // Monitor tab reads from Application Insights. Without LITELLM_OTEL_V2 nothing is sent.
  // The collector sidecar listens on 127.0.0.1 only.
  { name: 'LITELLM_OTEL_V2', value: 'true' }
  { name: 'OTEL_EXPORTER', value: 'otlp_http' }
  { name: 'OTEL_ENDPOINT', value: 'http://127.0.0.1:4318' }
  { name: 'OTEL_EXPORTER_OTLP_ENDPOINT', value: 'http://127.0.0.1:4318' }
  { name: 'OTEL_SERVICE_NAME', value: name }
]
var redisEnv = production ? [
  { name: 'REDIS_HOST', value: redis!.properties.hostName }
  { name: 'REDIS_PORT', value: '10000' }
  { name: 'REDIS_PASSWORD', secretRef: 'redis-password' }
  { name: 'REDIS_SSL', value: 'True' }
] : []

resource gateway 'Microsoft.App/containerApps@2025-01-01' = {
  name: name
  location: location
  tags: union(gatewayTags, {
    'ai-gateway-app-insights': insights.id
    'ai-gateway-profile': profile
  })
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${identity.id}': {} }
  }
  properties: {
    environmentId: environment.id
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: {
        external: true
        targetPort: 4000
        transport: 'auto'
        allowInsecure: false
      }
      secrets: concat(baseSecrets, redisSecrets)
    }
    template: {
      containers: [
        {
          name: 'litellm'
          image: image
          args: [ '--config', '/app/config/config.yaml', '--port', '4000' ]
          resources: {
            cpu: json(production ? '1.75' : '1.0')
            memory: production ? '3.5Gi' : '2Gi'
          }
          env: concat(baseEnv, redisEnv)
          volumeMounts: [ { volumeName: 'config', mountPath: '/app/config' } ]
          probes: [
            {
              // Database migrations run on the first start; give them time.
              type: 'Startup'
              httpGet: { path: '/health/liveliness', port: 4000 }
              periodSeconds: 10
              failureThreshold: 30
            }
            {
              type: 'Liveness'
              httpGet: { path: '/health/liveliness', port: 4000 }
              periodSeconds: 30
            }
            {
              type: 'Readiness'
              httpGet: { path: '/health/readiness', port: 4000 }
              periodSeconds: 10
            }
          ]
        }
        {
          name: 'otel-collector'
          image: collectorImage
          args: [ '--config', '/app/config/otel.yaml' ]
          resources: { cpu: json('0.25'), memory: '0.5Gi' }
          env: [ { name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', secretRef: 'appinsights-connection-string' } ]
          volumeMounts: [ { volumeName: 'config', mountPath: '/app/config' } ]
        }
      ]
      volumes: [
        {
          name: 'config'
          storageType: 'Secret'
          secrets: [
            { secretRef: 'litellm-config', path: 'config.yaml' }
            { secretRef: 'otel-config', path: 'otel.yaml' }
          ]
        }
      ]
      scale: {
        minReplicas: production ? 2 : 1
        maxReplicas: production ? 5 : 1
        rules: [
          {
            name: 'http'
            http: { metadata: { concurrentRequests: '50' } }
          }
        ]
      }
    }
  }
}

output url string = 'https://${gateway.properties.configuration.ingress.fqdn}'
output principalId string = identity.properties.principalId
output appInsightsId string = insights.id
