{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "apimName": { "value": "${APIM_NAME}" },
    "apimSkuName": { "value": "${APIM_SKU=BasicV2}" },
    "apimPublisherEmail": { "value": "${APIM_PUBLISHER_EMAIL}" },
    "apimResourceGroup": { "value": "${APIM_RESOURCE_GROUP}" },
    "apimSubscriptionId": { "value": "${APIM_SUBSCRIPTION_ID=${AZURE_SUBSCRIPTION_ID}}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID}" },
    "owners": { "value": "${POOL_OWNERS}" },
    "enableDelegatedAzureAccess": { "value": "${ENABLE_DELEGATED_AZURE_ACCESS=false}" }
  }
}
