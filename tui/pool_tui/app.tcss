/* Omarchy style: rounded panes on the plain background, the focused pane in the accent colour,
   muted titles, no heavy fills. Colours come from theme.py. */
Screen {
    background: $background;
    color: $foreground;
}

#topbar {
    height: 1;
    padding: 0 1;
    background: $surface;
}

#views {
    height: 1fr;
}

.pane {
    border: round $pane-border;
    border-title-color: $muted;
    border-title-align: left;
    border-subtitle-color: $muted;
    border-subtitle-align: right;
    padding: 0 1;
    background: $background;
    height: auto;
}

.pane:focus-within {
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
}

.grow {
    height: 1fr;
}

.muted {
    color: $muted;
}

DataTable {
    background: $background;
    height: auto;
    max-height: 100%;
}

DataTable > .datatable--header {
    background: $background;
    color: $muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary 25%;
    color: $foreground;
}

DataTable:blur > .datatable--cursor {
    background: $panel;
}

DataTable > .datatable--hover {
    background: $panel;
}

Footer {
    background: $surface;
}

/* Pools */
#pool-list-pane {
    width: 36;
    height: 1fr;
}

#pool-detail {
    height: 1fr;
}

#pool-summary {
    height: auto;
}

.spark-row {
    height: 1;
}

.spark-row Label {
    width: 18;
    color: $muted;
}

.spark-row TextSpark {
    width: 1fr;
}

#monitor-members {
    margin-top: 1;
}

/* Setup */
#setup-checks-pane {
    height: auto;
    max-height: 60%;
}

#setup-detail-pane {
    height: 1fr;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: $background 70%;
}

.dialog {
    width: 92;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $muted;
    border-subtitle-align: right;
    background: $surface;
    padding: 1 2;
}

.dialog.wide {
    width: 120;
}

.dialog Input, .dialog Select, .dialog TextArea {
    margin-bottom: 1;
}

.dialog Label {
    color: $muted;
}

/* Containers default to 1fr, which would let the first row swallow the whole dialog. */
.dialog Vertical, .dialog Horizontal, .dialog .row {
    height: auto;
}

.dialog .row > * {
    width: 1fr;
}

.dialog .buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.dialog Button {
    margin-left: 1;
    min-width: 12;
}

.dialog OptionList {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
    background: $surface;
}

.dialog TextArea {
    height: 8;
}

#test-response {
    height: 12;
}

.error-text {
    color: $error;
}

.ok-text {
    color: $success;
}

.warn-text {
    color: $warning;
}
