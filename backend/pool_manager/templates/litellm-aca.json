{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "12044474409231423010"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "metadata": {
        "description": "Name of the gateway; the Container App gets this name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "profile": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "production"
      ],
      "metadata": {
        "description": "dev: one replica, no Redis. production: 2-5 replicas sharing cooldowns through Redis."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/berriai/litellm:v1.106.4",
      "metadata": {
        "description": "LiteLLM image, pinned so a redeploy never changes the version by itself."
      }
    },
    "collectorImage": {
      "type": "string",
      "defaultValue": "otel/opentelemetry-collector-contrib:0.120.0"
    },
    "masterKey": {
      "type": "securestring",
      "metadata": {
        "description": "LiteLLM master key (sk-...)."
      }
    },
    "saltKey": {
      "type": "securestring",
      "metadata": {
        "description": "LiteLLM salt key, which encrypts stored credentials. Never change it."
      }
    },
    "postgresPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password of the Postgres administrator (letters and digits)."
      }
    },
    "litellmConfig": {
      "type": "securestring",
      "metadata": {
        "description": "LiteLLM config.yaml, generated by the app."
      }
    },
    "collectorConfig": {
      "type": "securestring",
      "metadata": {
        "description": "OpenTelemetry Collector config, generated by the app."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },
  "variables": {
    "production": "[equals(parameters('profile'), 'production')]",
    "suffix": "[uniqueString(resourceGroup().id, parameters('name'))]",
    "gatewayTags": "[union(parameters('tags'), createObject('managed-by', 'ai-gateway-pool', 'ai-gateway', parameters('name')))]",
    "postgresName": "[take(format('psql-{0}-{1}', parameters('name'), variables('suffix')), 63)]",
    "redisName": "[take(format('redis-{0}-{1}', parameters('name'), variables('suffix')), 60)]"
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), 'litellm')]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), 'AllowAllAzureServicesAndResourcesWithinAzureIps')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('log-{0}', parameters('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('gatewayTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[format('appi-{0}', parameters('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('gatewayTags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('name')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('name')))]"
      ]
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('id-{0}', parameters('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('gatewayTags')]"
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('postgresName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('gatewayTags')]",
      "sku": {
        "name": "[if(variables('production'), 'Standard_B2s', 'Standard_B1ms')]",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "litellm",
        "administratorLoginPassword": "[parameters('postgresPassword')]",
        "storage": {
          "storageSizeGB": 32
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        },
        "authConfig": {
          "activeDirectoryAuth": "Disabled",
          "passwordAuth": "Enabled"
        }
      }
    },
    {
      "condition": "[variables('production')]",
      "type": "Microsoft.Cache/redisEnterprise",
      "apiVersion": "2025-04-01",
      "name": "[variables('redisName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('gatewayTags')]",
      "sku": {
        "name": "Balanced_B0"
      },
      "properties": {
        "minimumTlsVersion": "1.2"
      }
    },
    {
      "condition": "[variables('production')]",
      "type": "Microsoft.Cache/redisEnterprise/databases",
      "apiVersion": "2025-04-01",
      "name": "[format('{0}/{1}', variables('redisName'), 'default')]",
      "properties": {
        "clientProtocol": "Encrypted",
        "port": 10000,
        "clusteringPolicy": "EnterpriseCluster",
        "evictionPolicy": "NoEviction",
        "accessKeysAuthentication": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cache/redisEnterprise', variables('redisName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[format('cae-{0}', parameters('name'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('gatewayTags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('name'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('name'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('name')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[union(variables('gatewayTags'), createObject('ai-gateway-app-insights', resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('name'))), 'ai-gateway-profile', parameters('profile')))]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('name'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', parameters('name')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 4000,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": "[concat(createArray(createObject('name', 'litellm-master-key', 'value', parameters('masterKey')), createObject('name', 'litellm-salt-key', 'value', parameters('saltKey')), createObject('name', 'database-url', 'value', format('postgresql://litellm:{0}@{1}:5432/litellm?sslmode=require', parameters('postgresPassword'), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName')), '2024-08-01').fullyQualifiedDomainName)), createObject('name', 'litellm-config', 'value', parameters('litellmConfig')), createObject('name', 'otel-config', 'value', parameters('collectorConfig')), createObject('name', 'appinsights-connection-string', 'value', reference(resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('name'))), '2020-02-02').ConnectionString)), if(variables('production'), createArray(createObject('name', 'redis-password', 'value', listKeys(resourceId('Microsoft.Cache/redisEnterprise/databases', variables('redisName'), 'default'), '2025-04-01').primaryKey)), createArray()))]"
        },
        "template": {
          "containers": [
            {
              "name": "litellm",
              "image": "[parameters('image')]",
              "args": [
                "--config",
                "/app/config/config.yaml",
                "--port",
                "4000"
              ],
              "resources": {
                "cpu": "[json(if(variables('production'), '1.75', '1.0'))]",
                "memory": "[if(variables('production'), '3.5Gi', '2Gi')]"
              },
              "env": "[concat(createArray(createObject('name', 'LITELLM_MASTER_KEY', 'secretRef', 'litellm-master-key'), createObject('name', 'LITELLM_SALT_KEY', 'secretRef', 'litellm-salt-key'), createObject('name', 'DATABASE_URL', 'secretRef', 'database-url'), createObject('name', 'STORE_MODEL_IN_DB', 'value', 'True'), createObject('name', 'AZURE_CLIENT_ID', 'value', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('name'))), '2023-01-31').clientId), createObject('name', 'LITELLM_OTEL_V2', 'value', 'true'), createObject('name', 'OTEL_EXPORTER', 'value', 'otlp_http'), createObject('name', 'OTEL_ENDPOINT', 'value', 'http://127.0.0.1:4318'), createObject('name', 'OTEL_EXPORTER_OTLP_ENDPOINT', 'value', 'http://127.0.0.1:4318'), createObject('name', 'OTEL_SERVICE_NAME', 'value', parameters('name'))), if(variables('production'), createArray(createObject('name', 'REDIS_HOST', 'value', reference(resourceId('Microsoft.Cache/redisEnterprise', variables('redisName')), '2025-04-01').hostName), createObject('name', 'REDIS_PORT', 'value', '10000'), createObject('name', 'REDIS_PASSWORD', 'secretRef', 'redis-password'), createObject('name', 'REDIS_SSL', 'value', 'True')), createArray()))]",
              "volumeMounts": [
                {
                  "volumeName": "config",
                  "mountPath": "/app/config"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health/liveliness",
                    "port": 4000
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 30
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health/liveliness",
                    "port": 4000
                  },
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health/readiness",
                    "port": 4000
                  },
                  "periodSeconds": 10
                }
              ]
            },
            {
              "name": "otel-collector",
              "image": "[parameters('collectorImage')]",
              "args": [
                "--config",
                "/app/config/otel.yaml"
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "secretRef": "appinsights-connection-string"
                }
              ],
              "volumeMounts": [
                {
                  "volumeName": "config",
                  "mountPath": "/app/config"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "config",
              "storageType": "Secret",
              "secrets": [
                {
                  "secretRef": "litellm-config",
                  "path": "config.yaml"
                },
                {
                  "secretRef": "otel-config",
                  "path": "otel.yaml"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[if(variables('production'), 2, 1)]",
            "maxReplicas": "[if(variables('production'), 5, 1)]",
            "rules": [
              {
                "name": "http",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', parameters('name')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('name')))]",
        "[resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('name')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]",
        "[resourceId('Microsoft.Cache/redisEnterprise', variables('redisName'))]",
        "[resourceId('Microsoft.Cache/redisEnterprise/databases', variables('redisName'), 'default')]"
      ]
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('name')), '2025-01-01').configuration.ingress.fqdn)]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('name'))), '2023-01-31').principalId]"
    },
    "appInsightsId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/components', format('appi-{0}', parameters('name')))]"
    }
  }
}
