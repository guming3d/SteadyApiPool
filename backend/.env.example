# Local development. Sign in with `az login`, or in the browser from the app's setup page.
# Local only. App Service refuses to start with authentication disabled.
POOL_MANAGER_AUTH_MODE=disabled
# The LiteLLM gateway is deployed, chosen or connected on the app's setup page and saved in
# backend/.pool-manager.json. To fix it here instead (the setup page then can't switch it), set
# all three for a gateway on Azure Container Apps:
# POOL_MANAGER_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# POOL_MANAGER_RESOURCE_GROUP=my-gateway-rg
# POOL_MANAGER_GATEWAY_NAME=my-gateway
# or, for a gateway elsewhere (AKS, any LiteLLM proxy with a database), its name and URL; the
# master key can be entered on the setup page, which keeps it encrypted on this machine:
# POOL_MANAGER_GATEWAY_NAME=my-gateway
# POOL_MANAGER_GATEWAY_URL=https://litellm.contoso.com
# POOL_MANAGER_GATEWAY_MASTER_KEY=sk-...
# POOL_MANAGER_OWNERS=alice@contoso.com,00000000-0000-0000-0000-000000000000
# ID prefixes of resources another tool manages; they are shown read-only:
# POOL_MANAGER_PROTECTED_PREFIXES=finops-
